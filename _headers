# ═══════════════════════════════════════════════════════════
# InnovaPeople — Cloudflare Pages Headers
# 06/06/2026: criado na frente FLUIDEZ+SEGURANÇA (CVO "dados sensíveis,
# não podemos vacilar"). A IP servia QUASE NENHUM security header (só
# referrer-policy) apesar de tratar CPF/salário/saúde ocupacional — lacuna
# real. Espelha o hardening da InnovaSphere, adaptado aos hosts que a IP usa
# (fonts.google, jsdelivr, auth/plat.innovasphere.ia.br, supabase, unsplash,
# mail.innovapeople.ia.br p/ a caixa embutida). + regras de cache p/ assets.
# CSP mantém 'unsafe-inline' (a IP usa handlers/scripts inline, igual à IS).
# ═══════════════════════════════════════════════════════════

# ── HTML (revalida sempre via ETag; 304 se não mudou) ──
/sistema/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' blob: data:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net blob: data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://auth.innovasphere.ia.br https://plat.innovasphere.ia.br https://innovapeople.ia.br https://accounts.google.com https://www.googleapis.com; img-src 'self' https://images.unsplash.com https://*.supabase.co https://*.googleusercontent.com data: blob:; media-src 'self' https://*.supabase.co blob:; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; frame-src 'self' https://mail.innovapeople.ia.br https://accounts.google.com; object-src 'none'; base-uri 'self'

# ── JS / CSS (cache via ETag: 304 quando inalterado, sem re-download) ──
/sistema/js/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/sistema/_shared/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# ── Fonts ──
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── Imagens ──
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# ── Security headers globais (fallback) ──
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
